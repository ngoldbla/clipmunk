# Clipmunk Fastfile — native gym/pilot/deliver replacement for scripts/testflight.sh.
#
# This is a *native macOS* app generated by XcodeGen (project.yml → Clipmunk.xcodeproj,
# which is NOT committed). Every lane regenerates the project first.
#
# Auth: an App Store Connect API key (App Manager/Admin) drives signing, the
# TestFlight build-number lookup, and the upload — matching the old script's contract:
#   ASC_KEY_ID     e.g. 44V6J6H27J   (matches AuthKey_<ID>.p8)
#   ASC_ISSUER_ID  issuer UUID
#   ASC_KEY_PATH   optional; defaults to ~/.appstoreconnect/private_keys/AuthKey_<ID>.p8
#   HF_DOWNLOAD_TOKEN  read token for the gated Marlin-2B model (else testers 401)
#
# Non-negotiable build flags carried through gym's xcargs (see project.yml comments):
#   ARCHS=arm64                 KokoroTTS uses Float16 → universal archives can't compile.
#   -scmProvider system         Xcode's builtin SCM hangs on this project.
#   -skipMacroValidation
#   -skipPackagePluginValidation
#   -allowProvisioningUpdates + API-key auth args   automatic signing via the key.
#   HF_DOWNLOAD_TOKEN=…         injected into Info.plist's HFDownloadToken.
#   CURRENT_PROJECT_VERSION=<n> client-side build number (see below).

default_platform(:mac)

# Repo root (this Fastfile lives in <root>/fastlane). Use absolute paths everywhere
# so nothing depends on Fastlane's working directory.
REPO         = File.expand_path("..", __dir__)
XCODEPROJ    = File.join(REPO, "Clipmunk.xcodeproj")
ARCHIVE_PATH = File.join(REPO, "build", "Clipmunk-AppStore.xcarchive")
EXPORT_DIR   = File.join(REPO, "build", "appstore-export")
SCHEME       = "Clipmunk"

# --- helpers ----------------------------------------------------------------

# App Store Connect API key object, reused by every ASC-touching action.
def asc_api_key
  key_id = ENV.fetch("ASC_KEY_ID") { UI.user_error!("set ASC_KEY_ID to the App Store Connect API key id") }
  issuer = ENV.fetch("ASC_ISSUER_ID") { UI.user_error!("set ASC_ISSUER_ID to the App Store Connect issuer id") }
  path   = ENV["ASC_KEY_PATH"] || File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  UI.user_error!("API key not found at #{path}") unless File.exist?(path)
  app_store_connect_api_key(key_id: key_id, issuer_id: issuer, key_filepath: path, in_house: false)
end

# xcodebuild auth flags for -allowProvisioningUpdates (gym runs xcodebuild, which
# needs the raw key flags — the api_key hash above is for pilot/deliver).
def xcode_auth_args
  key_id = ENV.fetch("ASC_KEY_ID")
  issuer = ENV.fetch("ASC_ISSUER_ID")
  path   = ENV["ASC_KEY_PATH"] || File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  "-allowProvisioningUpdates " \
    "-authenticationKeyPath #{path.shellescape} " \
    "-authenticationKeyID #{key_id} " \
    "-authenticationKeyIssuerID #{issuer}"
end

# Single source of truth for the marketing version stays project.yml.
def marketing_version
  File.read(File.join(REPO, "project.yml"))[/MARKETING_VERSION:\s*"([^"]+)"/, 1] \
    || UI.user_error!("could not read MARKETING_VERSION from project.yml")
end

def generate_project
  UI.user_error!("xcodegen not installed (brew install xcodegen)") if `which xcodegen`.strip.empty?
  sh("cd #{REPO.shellescape} && xcodegen generate")
end

# Archive the sandboxed AppStore config and export a *local* .pkg (no upload), then
# run the same structural guards the DMG/testflight scripts use. Returns the .pkg path.
# Callers upload the vetted .pkg with pilot, so a broken archive never reaches TestFlight.
def build_appstore_pkg(build_number)
  hf = ENV["HF_DOWNLOAD_TOKEN"].to_s

  build_app(
    project: XCODEPROJ,
    scheme: SCHEME,
    configuration: "AppStore",
    destination: "platform=macOS",
    derived_data_path: File.join(REPO, "build"),
    archive_path: ARCHIVE_PATH,
    output_directory: EXPORT_DIR,
    # gym maps the plist's `method` onto its own export_method enum, which still
    # uses the legacy names — the Xcode-16/26 spelling "app-store-connect" (what
    # scripts/ExportOptions-AppStore-local.plist carries for raw xcodebuild) is
    # rejected. Let gym generate its own export options with a gym-legal method;
    # it exports locally (no upload) and automatic signing re-signs with Apple
    # Distribution via the -allowProvisioningUpdates + API-key args in xcargs.
    export_method: "app-store",
    export_team_id: "XC6FN96MA8",
    clean: false,
    xcargs: [
      "-scmProvider system",
      "-skipMacroValidation",
      "-skipPackagePluginValidation",
      xcode_auth_args,
      "ARCHS=arm64",
      "HF_DOWNLOAD_TOKEN=#{hf.shellescape}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
    ].join(" ")
  )

  app = File.join(ARCHIVE_PATH, "Products", "Applications", "Clipmunk.app")

  # MLX is dead without its precompiled Metal kernels; invisible until first inference.
  UI.user_error!("no .metallib in app bundle — Metal Toolchain missing at build time?") \
    if Dir.glob(File.join(app, "**", "*.metallib")).empty?

  # TestFlight rejects un-sandboxed Mac builds at upload time; fail early with a clear message.
  ents = sh("codesign -d --entitlements :- #{app.shellescape} 2>/dev/null || true", log: false)
  UI.user_error!("app-sandbox entitlement missing from the signed app") \
    unless ents.include?("com.apple.security.app-sandbox")

  pkg = Dir.glob(File.join(EXPORT_DIR, "*.pkg")).first
  UI.user_error!("no .pkg produced by export") unless pkg
  pkg
end

# Next TestFlight build number for the current marketing version (client-side bump,
# replacing the old manageAppVersionAndBuildNumber=true server-side scheme).
def next_build_number(api_key)
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: "com.github.ngoldbla.Clipmunk",
    version: marketing_version,
    platform: "osx",
    initial_build_number: 0
  )
  latest.to_i + 1
end

# --- lanes ------------------------------------------------------------------

platform :mac do
  desc "Compile-check the app (unsigned Debug build). Swap for `scan` once a test target exists."
  lane :test do
    generate_project
    sh("cd #{REPO.shellescape} && xcodebuild " \
       "-project Clipmunk.xcodeproj -scheme #{SCHEME} -configuration Debug " \
       "-destination 'platform=macOS' -scmProvider system -derivedDataPath build " \
       "-skipMacroValidation -skipPackagePluginValidation CODE_SIGNING_ALLOWED=NO build")
  end

  desc "Build + upload to TestFlight (internal). Hands-off build number via ASC lookup."
  lane :beta do
    api_key = asc_api_key
    generate_project
    pkg = build_appstore_pkg(next_build_number(api_key))
    upload_to_testflight(
      api_key: api_key,
      app_platform: "osx",
      pkg: pkg,
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded to TestFlight. Watch processing in App Store Connect → TestFlight.")
  end

  desc "Build + upload to TestFlight and distribute to the External Testers group."
  lane :beta_external do |options|
    api_key = asc_api_key
    generate_project
    pkg = build_appstore_pkg(next_build_number(api_key))
    upload_to_testflight(
      api_key: api_key,
      app_platform: "osx",
      pkg: pkg,
      distribute_external: true,
      groups: ["External Testers"],
      changelog: options[:changelog] || "Bug fixes and improvements",
      # Must wait for processing before external distribution can attach the build.
      skip_waiting_for_build_processing: false
    )
  end

  desc "Build + export a .pkg locally and validate it with ASC — consumes NO TestFlight build."
  lane :validate do
    api_key = asc_api_key
    generate_project
    pkg = build_appstore_pkg(next_build_number(api_key))
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer = ENV.fetch("ASC_ISSUER_ID")
    sh("xcrun altool --validate-app -f #{pkg.shellescape} -t macos --apiKey #{key_id} --apiIssuer #{issuer}")
    UI.success("Validated #{pkg} — no TestFlight build consumed.")
  end

  desc "Submit the latest TestFlight build for App Store review (no rebuild)."
  lane :release do
    api_key = asc_api_key
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.github.ngoldbla.Clipmunk",
      version: marketing_version,
      platform: "osx"
    ).to_s
    deliver(
      api_key: api_key,
      platform: "osx",
      build_number: build,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      # Enable these once fastlane/metadata + screenshots exist
      # (fastlane deliver download_metadata / download_screenshots).
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end
